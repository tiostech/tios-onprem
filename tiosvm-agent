#!/usr/bin/env python3
"""
tiosvm-agent - connects an on-prem KVM host to tiosaws.

tiosaws can't reach the host, so the agent asks it for work. Every few seconds it calls
POST <TIOSAWS_URL>/onprem/sync with:
  instances  the tiosvm VMs on this host (ID, IP, state)
  gone       VMs that disappeared since the last sync (terminated or self-shut-down)
  failed     launches that failed
  requeue    launches the host had no room for (tiosvm exit code 3); tiosaws puts them back first
and gets back {launch: request or null, terminate: [instance IDs]}, which it runs with tiosvm.

Config: /etc/tiosvm/agent.conf (KEY=VALUE)
  TIOSAWS_URL   e.g. https://ec2manager-stage.tioscapital.com
  DNS_SERVER    optional; resolve the tiosaws name through this DNS server (e.g. 10.50.0.1,
                the VM network's dnsmasq, which forwards tioscapital.com to the AWS VPC DNS)
  INTERVAL      seconds between syncs (default 10)
Token: /etc/tiosvm/agent-token (same value as Redis key onprem.agent_token in tiosaws)
"""

import base64
import glob
import http.client
import json
import os
import socket
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.parse

CONF_FILE = "/etc/tiosvm/agent.conf"
TOKEN_FILE = "/etc/tiosvm/agent-token"
STATE_DIR = "/var/lib/tiosvm/instances"
AGENT_DIR = "/var/lib/tiosvm/agent"
SPOOL_DIR = os.path.join(AGENT_DIR, "spool")         # claimed launches not finished yet
KNOWN_FILE = os.path.join(AGENT_DIR, "known.json")   # VM IDs seen at the last sync
TIOSVM = "/usr/local/bin/tiosvm"
BASE_DIR = "/var/lib/libvirt/base"
CAPACITY_EXIT = 3


def log(msg):
    print(msg, flush=True)


def read_conf():
    conf = {"INTERVAL": "10", "DNS_SERVER": ""}
    with open(CONF_FILE) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip().strip('"')
    if not conf.get("TIOSAWS_URL"):
        sys.exit(f"TIOSAWS_URL is missing in {CONF_FILE}")
    with open(TOKEN_FILE) as f:
        conf["TOKEN"] = f.read().strip()
    return conf


# ---- HTTPS to tiosaws, optionally resolving its name through DNS_SERVER ----------------------

def resolve(host, dns_server):
    if not dns_server:
        return host
    out = subprocess.run(["dig", "+short", "+time=3", "+tries=2", f"@{dns_server}", host, "A"],
                         capture_output=True, text=True).stdout.split()
    ips = [x for x in out if x.replace(".", "").isdigit()]
    if not ips:
        raise RuntimeError(f"cannot resolve {host} via {dns_server}")
    return ips[0]


class PinnedHTTPSConnection(http.client.HTTPSConnection):
    """HTTPS to a given IP, while TLS still checks the certificate for the real host name."""

    def __init__(self, host, ip, **kw):
        super().__init__(host, **kw)
        self._ip = ip

    def connect(self):
        sock = socket.create_connection((self._ip, self.port or 443), self.timeout)
        self.sock = self._context.wrap_socket(sock, server_hostname=self.host)


def post_sync(conf, payload):
    url = urllib.parse.urlparse(conf["TIOSAWS_URL"].rstrip("/") + "/onprem/sync")
    ip = resolve(url.hostname, conf["DNS_SERVER"])
    conn = PinnedHTTPSConnection(url.hostname, ip, port=url.port or 443, timeout=30,
                                 context=ssl.create_default_context())
    try:
        conn.request("POST", url.path, body=json.dumps(payload),
                     headers={"Content-Type": "application/json", "X-Onprem-Agent-Token": conf["TOKEN"]})
        resp = conn.getresponse()
        body = resp.read().decode()
        if resp.status != 200:
            raise RuntimeError(f"sync HTTP {resp.status}: {body[:300]}")
        return json.loads(body)
    finally:
        conn.close()


# ---- Local VMs -------------------------------------------------------------------------------

def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def local_instances():
    vms = []
    for path in glob.glob(os.path.join(STATE_DIR, "i-*.json")):
        try:
            with open(path) as f:
                inst = json.load(f)
        except (OSError, ValueError):
            continue
        state = run(["virsh", "-c", "qemu:///system", "domstate", inst["id"]]).stdout.strip() or "missing"
        vms.append({"id": inst["id"], "ip": inst.get("ip"), "state": state.replace(" ", "-")})
    return vms


def load_known():
    try:
        with open(KNOWN_FILE) as f:
            return set(json.load(f))
    except (OSError, ValueError):
        return set()


def save_known(ids):
    tmp = KNOWN_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(sorted(ids), f)
    os.replace(tmp, KNOWN_FILE)


def pick_image(req):
    """Baked image for this launch, or None for plain Ubuntu.

    tiosaws sends the launcher's image name (e.g. "ftrpowerflow"). It is used if this host has
    <name>-latest.img. Image builders (tiosvm-rebake, name "...-imagebuilder.") always start
    from plain Ubuntu so every rebake is a clean build.
    """
    name = req.get("image")
    if not name or "-imagebuilder." in req.get("name", ""):
        return None, 0
    path = os.path.join(BASE_DIR, f"{name}-latest.img")
    if not os.path.exists(path):
        return None, 0
    info = run(["qemu-img", "info", "-U", "--output", "json", path])
    try:
        gb = json.loads(info.stdout)["virtual-size"] // (1024 ** 3)
    except (ValueError, KeyError):
        return None, 0
    return name, gb


def launch(req):
    """Returns ('ok' | 'full' | 'failed', error text)."""
    iid = req["instance_id"]
    if os.path.exists(os.path.join(STATE_DIR, f"{iid}.json")):
        return "ok", ""  # already launched (e.g. agent restarted after launching)
    with tempfile.NamedTemporaryFile("wb", delete=False, dir=AGENT_DIR, suffix=".user-data") as f:
        f.write(base64.b64decode(req["user_data_base64"]))
        user_data = f.name
    image, image_gb = pick_image(req)
    disk_gb = max(int(req["disk_gb"]), image_gb)  # a VM disk can't be smaller than its image
    cmd = [TIOSVM, "launch", "--instance-id", iid, "--name", req["name"],
           "--type", req["instance_type"], "--disk", f"{disk_gb}G",
           "--user-data", user_data]
    if image:
        cmd += ["--image", image]
    if req.get("iam_role"):
        cmd += ["--iam-role", req["iam_role"]]
    if req.get("terminate_on_shutdown"):
        cmd.append("--terminate-on-shutdown")
    for k, v in (req.get("tags") or {}).items():
        if k != "Name":
            cmd += ["--tag", f"{k}={v}"]
    try:
        r = run(cmd)
    finally:
        os.unlink(user_data)
    if r.returncode == 0:
        log(f"launched {iid} ({req['instance_type']}, image {image or 'plain ubuntu'}) "
            f"{r.stdout.splitlines()[0] if r.stdout else ''}")
        return "ok", ""
    if r.returncode == CAPACITY_EXIT:
        return "full", r.stderr.strip()
    return "failed", (r.stderr or r.stdout).strip()[-500:]


def main():
    conf = read_conf()
    os.makedirs(SPOOL_DIR, exist_ok=True)
    interval = int(conf["INTERVAL"])
    log(f"tiosvm-agent syncing with {conf['TIOSAWS_URL']} every {interval}s")

    failed, requeue = [], []
    while True:
        try:
            # Launches claimed before a restart: finish them first
            for path in sorted(glob.glob(os.path.join(SPOOL_DIR, "*.json"))):
                with open(path) as f:
                    req = json.load(f)
                result, err = launch(req)
                if result == "full":
                    requeue.append(req)
                elif result == "failed":
                    failed.append({"id": req["instance_id"], "error": err})
                os.unlink(path)

            vms = local_instances()
            ids = {v["id"] for v in vms}
            gone = sorted(load_known() - ids)
            resp = post_sync(conf, {"instances": vms, "gone": gone, "failed": failed, "requeue": requeue})
            save_known(ids)
            failed, requeue = [], []

            for iid in resp.get("terminate") or []:
                if iid in ids:
                    r = run([TIOSVM, "terminate", iid])
                    log(r.stdout.strip() or r.stderr.strip())

            req = resp.get("launch")
            if req:
                spool = os.path.join(SPOOL_DIR, f"{req['instance_id']}.json")
                with open(spool, "w") as f:
                    json.dump(req, f)
                continue  # launch it at the top of the loop, right away
        except Exception as e:  # noqa: BLE001 - keep running; tiosaws or the network may be down
            log(f"sync error: {e}")
        time.sleep(interval)


if __name__ == "__main__":
    main()
